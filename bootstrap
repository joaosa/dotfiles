#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# If run via curl | bash, clone the repo first.
if [ ! -f "$SCRIPT_DIR/flake.nix" ] || [ ! -f "$SCRIPT_DIR/modules/doctor.sh" ]; then
  REPO_DIR="$HOME/ghq/github.com/joaosa/dotfiles"
  if [ ! -d "$REPO_DIR" ]; then
    if ! xcode-select -p >/dev/null 2>&1; then
      xcode-select --install 2>/dev/null || true
      echo "Waiting for Xcode Command Line Tools..."
      until xcode-select -p >/dev/null 2>&1; do sleep 5; done
    fi
    git clone https://github.com/joaosa/dotfiles "$REPO_DIR"
  fi
  exec "$REPO_DIR/bootstrap" "$@"
fi

usage() {
  cat <<'EOF'
Usage: ./bootstrap [doctor]

Run the local setup health checks.

Options:
  --help    Show this help
  --list    List available checks
EOF
}

case "${1:-doctor}" in
  -h|--help)
    usage
    ;;
  --list)
    echo "doctor"
    ;;
  doctor)
    if [ "$#" -gt 0 ]; then
      shift
    fi
    if [ "$#" -gt 0 ]; then
      echo "Unexpected arguments: $*" >&2
      usage >&2
      exit 1
    fi
    exec bash "$SCRIPT_DIR/modules/doctor.sh"
    ;;
  *)
    echo "Unknown check: $1" >&2
    usage >&2
    exit 1
    ;;
esac
