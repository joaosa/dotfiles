{
  config,
  lib,
  pkgs,
  username,
  homeDir,
  dotfilesPath,
  ...
}:

let
  link = relativePath: config.lib.file.mkOutOfStoreSymlink "${dotfilesPath}/${relativePath}";
  kubectlAliases = pkgs.fetchurl {
    url = "https://raw.githubusercontent.com/ahmetb/kubectl-aliases/7549fa45bbde7499b927c74cae13bfb9169c9497/.kubectl_aliases";
    hash = "sha256-Kqb6kk2EZjoX55flZqiuNRLJQDfC2XMgO+F3tyCEnqk=";
  };
  homePackages = import ../packages.nix {
    inherit pkgs;
  };
  qwen3AsrModel = import ./qwen3-asr.nix { inherit pkgs; };
  # Same derivation that puts `devc` on PATH; `agent` stages its templates.
  devc = pkgs.callPackage ../packages/devc.nix { };
  fdFiles = "fd --type f --hidden --follow --exclude .git";
  # Config files for cross-platform tools, symlinked out-of-store from this repo
  # so edits take effect without a rebuild. macOS-app configs live in darwin.nix.
  commonFiles = {
    ".colima/default/colima.yaml" = {
      source = link "config/colima/colima.yaml";
      # colima writes this file itself; force past any real file / stale backup
      # so activation never aborts on a clobber collision.
      force = true;
    };
    ".config/alacritty/alacritty.toml".source = link "config/alacritty/alacritty.toml";
    ".config/nvim/init.lua".source = link "config/nvim/init.lua";
    ".config/nvim/lua".source = link "config/nvim/lua";
    ".config/git/allowed_signers".source = link "config/git/allowed_signers";
    ".config/ruff/ruff.toml".source = link "config/ruff/ruff.toml";
    ".gitconfig".source = link "config/git/gitconfig";
    ".gitignore_global".source = link "config/git/gitignore_global";
    ".kubectl_aliases" = {
      source = kubectlAliases;
      force = true;
    };
    ".lightline.conf".source = link "config/tmux/lightline.conf";
    ".parallel/will-cite" = {
      text = "";
      force = true;
    };
    ".stylua.toml".source = link "config/stylua/stylua.toml";
    ".tmux.conf".source = link "config/tmux/tmux.conf";
    ".yamllint".source = link "config/yamllint/yamllint";
    # Keep Claude's established shared tree as the canonical copy while also
    # exposing it at Codex's documented user-level skill discovery path.
    ".agents/skills" = {
      source = config.lib.file.mkOutOfStoreSymlink "${claudeSharedDir}/skills";
      force = true;
    };
    # zsh runcoms (.zshrc/.zshenv/.zprofile) are generated by programs.zsh
    # below, not linked from config/.
  };
  # Multi-account Claude Code: each profile is an isolated CLAUDE_CONFIG_DIR
  # holding its own credentials and session state. `main` deliberately *is*
  # ~/.claude, so a bare `claude` and `ccm` are the same account and the
  # pre-profiles history/plugins/tasks keep working untouched.
  # (programs.claude-code rejected: single config dir, read-only settings.json.)
  claudeProfiles = {
    main = {
      dir = "${homeDir}/.claude";
      keychainService = "claude-code-oauth";
    };
    alt = {
      dir = "${homeDir}/.claude-profiles/alt";
      keychainService = "claude-code-oauth-alt";
    };
  };
  claudeProfileDirs = lib.mapAttrs (_: profile: profile.dir) claudeProfiles;
  claudeProfileKeychainServices = lib.mapAttrs (_: profile: profile.keychainService) claudeProfiles;
  # Explicit, not `lib.head`: attrNames sorts alphabetically, which would make
  # ccuse's unset-vs-export default land on alt.
  claudeDefaultProfile = "main";
  # Also hardcoded in the config/agent-devcontainer/*.devcontainer.json mounts.
  claudeSharedDir = "${homeDir}/.claude-shared";
  claudeSharedDirs = [
    "commands"
    "agents"
    "skills"
  ];
  claudeSharedItems = claudeSharedDirs ++ [ "CLAUDE.md" ];
  # Account-agnostic settings, re-asserted into every profile's own
  # settings.json on activation (see claudeSettingsMerge). Keys deliberately
  # absent here — model, theme, enabledPlugins — stay per-profile and remain
  # freely editable via /config, since plugins are installed per config dir and
  # the accounts want different models.
  claudeSharedSettings = {
    alwaysThinkingEnabled = false;
    editorMode = "vim";
    effortLevel = "high";
    agentPushNotifEnabled = true;
    skipAutoPermissionPrompt = true;
    skipWorkflowUsageWarning = true;
    switchModelsOnFlag = true;
    tui = "default";
    # Outbound data always prompts, auto mode included. Arrays replace on
    # merge, so a per-profile permissions.ask is overwritten by this list.
    permissions.ask = [
      "WebFetch"
      "WebSearch"
      "Artifact"
      "Bash(curl:*)"
      "Bash(wget:*)"
      "Bash(git push:*)"
      "Bash(gh:*)"
      "mcp__claude_ai_Notion"
      "mcp__claude_ai_Gmail"
      "mcp__claude_ai_Google_Drive"
      "mcp__claude_ai_Google_Calendar"
      "mcp__claude_ai_Claude_Docs"
    ];
    hooks =
      lib.genAttrs
        [
          "UserPromptSubmit"
          "Stop"
          "Notification"
        ]
        (event: [
          {
            hooks = [
              {
                type = "command";
                # In .claude-shared, not a profile dir: shared config must not
                # depend on any one account's directory.
                command = "python3 ${claudeSharedDir}/ccnotify/ccnotify.py ${event}";
              }
            ];
          }
        ]);
  };
  # Read only by claudeSettingsMerge, straight from the store.
  claudeSharedSettingsFile = pkgs.writeText "claude-shared-settings.json" (
    builtins.toJSON claudeSharedSettings
  );
  # home.file keys are relative to $HOME, so strip the prefix back off —
  # loudly, since removePrefix is a silent no-op on non-matching input.
  claudeRelative =
    path:
    if lib.hasPrefix "${homeDir}/" path then
      lib.removePrefix "${homeDir}/" path
    else
      throw "claude dir ${path} is outside ${homeDir}";
  claudeProfileFiles = lib.listToAttrs (
    lib.concatMap (
      dir:
      map (item: {
        name = "${claudeRelative dir}/${item}";
        value = {
          source = config.lib.file.mkOutOfStoreSymlink "${claudeSharedDir}/${item}";
          # Pre-profile machines have real files here; force + the flake's
          # backupFileExtension move them to *.hm-backup instead of aborting.
          force = true;
        };
      }) claudeSharedItems
    ) (lib.attrValues claudeProfileDirs)
  );
  # cc<first letter> per profile: ccm/cca — the only launchers; no bare `cc`,
  # which would shadow the C compiler. Kept next to claudeProfileDirs so a
  # profile rename can't leave a stale alias behind.
  agent = pkgs.callPackage ../packages/agent.nix {
    inherit devc dotfilesPath;
    profiles = claudeProfileKeychainServices;
    defaultProfile = claudeDefaultProfile;
  };
  claudeProfileAliases = lib.mapAttrs' (
    profile: _: lib.nameValuePair "cc${lib.substring 0 1 profile}" "_claude_launch ${profile}"
  ) claudeProfileDirs;
in
{
  xdg.enable = true;

  home = {
    packages = homePackages ++ [ agent ];

    sessionPath = [
      "${homeDir}/.local/bin"
      "${homeDir}/.cargo/bin"
      "${homeDir}/.go/bin"
    ];

    sessionVariables = {
      # Stable profile symlinks only — never a per-generation store path, so
      # long-lived shells (tmux server) survive rebuild + GC. The per-user
      # profile carries the .pc files via pathsToLink in darwin/default.nix.
      PKG_CONFIG_PATH = lib.concatStringsSep ":" [
        "/etc/profiles/per-user/${username}/lib/pkgconfig"
        "/etc/profiles/per-user/${username}/share/pkgconfig"
        "${homeDir}/.nix-profile/lib/pkgconfig"
        "${homeDir}/.nix-profile/share/pkgconfig"
        "/run/current-system/sw/lib/pkgconfig"
        "/run/current-system/sw/share/pkgconfig"
      ];
      # colima.yaml is repo-managed (see commonFiles); stop `colima start`
      # writing its effective config back through the symlink.
      COLIMA_SAVE_CONFIG = "false";
      EDITOR = "nvim";
      VISUAL = "nvim";
      PAGER = "less";
      LANG = "en_US.UTF-8";
      GOPATH = "${homeDir}/.go";
      LESS = "-F -g -i -M -R -S -w -X -z-4";
    };

    file =
      commonFiles
      // claudeProfileFiles
      // {
        ".npmrc".text = ''
          prefix=${homeDir}/.local
        '';
        ".docker/cli-plugins/docker-buildx" = {
          source = "${pkgs.docker-buildx}/bin/docker-buildx";
          force = true;
        };
        ".local/share/qwen3-asr/Qwen3-ASR-0.6B" = {
          source = qwen3AsrModel;
          force = true;
        };
        # Vendored from github.com/dazuiba/CCNotify (source-audited). Staged
        # because the shared hooks call it: a missing hook target exits 2,
        # blocking every prompt. abspath(__file__) doesn't resolve symlinks,
        # so its db/log stay in the real ~/.claude-shared/ccnotify/.
        "${claudeRelative claudeSharedDir}/ccnotify/ccnotify.py" = {
          source = link "config/claude/ccnotify.py";
          force = true;
        };
      };

    activation = {
      npmPrefix = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        /bin/mkdir -p "${homeDir}/.local/bin" "${homeDir}/.local/lib/node_modules"
      '';

      # Seed the canonical shared-config tree the per-profile symlinks point
      # at, so the links are never dangling on a fresh machine. Pre-profile
      # content displaced to *.hm-backup by the symlink pass becomes the
      # seed, instead of an empty skeleton silently replacing it.
      claudeSharedSkeleton = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        /bin/mkdir -p ${lib.concatMapStringsSep " " (dir: ''"${claudeSharedDir}/${dir}"'') claudeSharedDirs}
        [ -e "${claudeSharedDir}/CLAUDE.md" ] || : > "${claudeSharedDir}/CLAUDE.md"
        for item in ${lib.concatStringsSep " " claudeSharedDirs}; do
          backup="${claudeProfileDirs.main}/$item.hm-backup"
          shared="${claudeSharedDir}/$item"
          if [ -d "$backup" ] && [ -z "$(/bin/ls -A "$shared")" ]; then
            /bin/cp -R "$backup/." "$shared/"
          fi
        done
        if [ -f "${claudeProfileDirs.main}/CLAUDE.md.hm-backup" ] \
          && [ ! -s "${claudeSharedDir}/CLAUDE.md" ]; then
          /bin/cp "${claudeProfileDirs.main}/CLAUDE.md.hm-backup" "${claudeSharedDir}/CLAUDE.md"
        fi
      '';

      # Re-assert the account-agnostic settings into each profile's writable
      # settings.json: /config edits to keys outside claudeSharedSettings
      # survive; keys inside it revert on the next switch. The .last file
      # tracks what was asserted so deleted shared keys get removed too.
      claudeSettingsMerge = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        for dir in ${lib.concatMapStringsSep " " (dir: ''"${dir}"'') (lib.attrValues claudeProfileDirs)}; do
          /bin/mkdir -p "$dir"
          target="$dir/settings.json"
          # -s, not -e: an empty file would fail the merge rather than seed it.
          [ -s "$target" ] || echo '{}' > "$target"

          # A corrupt profile file must not brick every later activation:
          # quarantine and reseed instead of aborting.
          if ! ${pkgs.jq}/bin/jq -e 'type == "object"' "$target" > /dev/null 2>&1; then
            echo "Quarantining unparseable $target to $target.corrupt" >&2
            /bin/mv "$target" "$target.corrupt"
            echo '{}' > "$target"
          fi

          applied="$dir/.claude-shared-settings.last"
          [ -s "$applied" ] || echo '{}' > "$applied"

          tmp="$target.hm-merge"
          if ${pkgs.jq}/bin/jq -s \
            '((.[1] | keys) - (.[2] | keys) | map([.])) as $stale
             | (.[0] | delpaths($stale)) * .[2]' \
            "$target" "$applied" "${claudeSharedSettingsFile}" > "$tmp"; then
            # Skip the rewrite when the merge is a no-op, so a routine switch
            # doesn't churn the mtime of a file a running Claude Code watches.
            if /usr/bin/cmp -s "$tmp" "$target"; then
              /bin/rm -f "$tmp"
            else
              /bin/mv "$tmp" "$target"
            fi
            /bin/cp "${claudeSharedSettingsFile}" "$applied"
          else
            /bin/rm -f "$tmp"
            echo "Failed to merge shared Claude settings into $target" >&2
            exit 1
          fi
        done
      '';
    };
  };

  services = {
    ollama = {
      enable = true;
      environmentVariables = {
        # Muse Glimmer's full window; ~12 GiB of q8_0 KV at 128k fits easily
        # in 128 GiB. Keep this aligned with OpenCode's model limit.
        OLLAMA_CONTEXT_LENGTH = "131072";
        OLLAMA_FLASH_ATTENTION = "1";
        # The launch agent stays alive; unload only the model after it has been
        # idle so the next request gets a fresh Metal-aware load.
        OLLAMA_KEEP_ALIVE = "30m";
        OLLAMA_KV_CACHE_TYPE = "q8_0";
      };
    };

    syncthing = {
      enable = true;
      overrideDevices = false;
      overrideFolders = false;
    };
  };

  programs = {
    home-manager.enable = true;

    fzf = {
      enable = true;
      enableZshIntegration = true;
      defaultCommand = fdFiles;
      defaultOptions = [
        "--reverse"
        "--border"
        "--preview 'bat --color=always --style=numbers --line-range=:200 {} 2>/dev/null || ls -1 {}'"
        "--preview-window right:50%:hidden"
        "--bind ?:toggle-preview"
        "--color=bg+:#3c3836,bg:#282828,spinner:#fb4934,hl:#928374"
        "--color=fg:#ebdbb2,header:#928374,info:#8ec07c,pointer:#fb4934"
        "--color=marker:#fb4934,fg+:#ebdbb2,prompt:#fb4934,hl+:#fb4934"
      ];
      fileWidget = {
        command = fdFiles;
        options = [ "--preview-window right:50%" ];
      };
      changeDirWidget = {
        command = "fd --type d --hidden --follow --exclude .git";
        options = [ "--preview 'ls -1 {}'" ];
      };
    };

    direnv = {
      enable = true;
      enableZshIntegration = true;
    };

    zoxide = {
      enable = true;
      enableZshIntegration = true;
    };

    starship = {
      enable = true;
      enableZshIntegration = true;
      settings = builtins.fromTOML (builtins.readFile ../../config/starship/starship.toml);
    };

    gh = {
      enable = true;
      extensions = [ pkgs.gh-stack ];
      settings = {
        git_protocol = "https";
        aliases.co = "pr checkout";
      };
    };

    gh-dash = {
      enable = true;
      settings = {
        prSections = [
          {
            title = "My Pull Requests";
            filters = "is:pr author:@me state:open archived:false sort:updated-desc";
          }
          {
            title = "Needs My Review";
            filters = "is:open review-requested:@me";
          }
          {
            title = "Merged";
            filters = "is:pr author:@me state:merged archived:false sort:updated-desc";
          }
          {
            title = "Involved";
            filters = "is:open involves:@me -author:@me";
          }
        ];
        issuesSections = [
          {
            title = "My Issues";
            filters = "is:open author:@me";
          }
          {
            title = "Assigned";
            filters = "is:open assignee:@me";
          }
        ];
      };
    };

    ssh = {
      enable = true;
      # No implicit Host * defaults from the module; everything is explicit.
      enableDefaultConfig = false;
      includes = [
        "${homeDir}/.colima/ssh_config"
        # Machine-local hosts that shouldn't be versioned (ephemeral
        # engagement/bastion entries); a glob so nothing breaks when empty.
        "${homeDir}/.ssh/config.d/*"
      ];
      settings."*" = {
        User = "root";
        # Load keys into the agent lazily on first use, instead of ssh-add
        # at shell startup. No IdentityFile: ssh tries its default identity
        # list, so keys aren't pinned by name here.
        AddKeysToAgent = "yes";
      };
    };

    zsh = {
      enable = true;
      dotDir = config.home.homeDirectory;
      enableCompletion = true;
      # One dump per zsh binary, keyed by the store/prefix dir that owns its
      # functions (fpath[-1]); Apple's and Nix's zsh have different fpaths, so a
      # shared dump is rebuilt whenever the other one starts.
      completionInit = ''
        autoload -U compinit && compinit -d "$HOME/.zcompdump-''${fpath[-1]:h:h:h:h:t}"
      '';
      autocd = false;
      defaultKeymap = "viins";

      history = {
        size = 1000000;
        save = 1000000;
        path = "${homeDir}/.zsh_history";
        extended = true;
        expireDuplicatesFirst = true;
        ignoreAllDups = true;
      };

      # Options prezto's environment/utility/completion modules set, minus
      # zsh defaults; a NO_ prefix unsets. History options live above.
      setOptions = [
        "COMBINING_CHARS"
        "INTERACTIVE_COMMENTS"
        "RC_QUOTES"
        "LONG_LIST_JOBS"
        "AUTO_RESUME"
        "NO_BG_NICE"
        "NO_HUP"
        "NO_CHECK_JOBS"
        "HIST_VERIFY"
        "NO_HIST_BEEP"
        "COMPLETE_IN_WORD"
        "ALWAYS_TO_END"
        "PATH_DIRS"
        "NO_FLOW_CONTROL"
      ];

      syntaxHighlighting = {
        enable = true;
        # "main" is included by default.
        highlighters = [
          "brackets"
          "pattern"
          "line"
          "root"
        ];
      };

      historySubstringSearch = {
        enable = true;
        # No main-keymap bindings; arrows are deliberate noops (see
        # initContent), search is bound to k/j in vi normal mode instead.
        searchUpKey = [ ];
        searchDownKey = [ ];
      };

      shellAliases = claudeProfileAliases // {
        vi = "nvim";
        vim = "nvim";
        ls = "ls --color=auto --group-directories-first";
        grep = "grep --color=auto";
        l = "ls -1A";
        ll = "ls -lh";
        la = "ls -lhA";
        # Interactive-by-default file ops, as prezto's utility safe-ops gave us.
        rm = "rm -i";
        mv = "mv -i";
        cp = "cp -i";
        ln = "ln -i";
        # Force character rendering: tmux advertises sixel support, so chafa
        # auto-picks it, but Alacritty can't display the resulting graphics.
        # Sextants/wedges come from the JuliaMono glyphs grafted into the
        # SauceCodePro font package; the stock font lacks them.
        chafa = "chafa -f symbols --symbols +sextant+wedge -w 9";
        gcom = "git checkout main";
        gbpm = "git fetch -p; git branch --merged main | grep -vE '^[*+]| (main|master)$' | xargs -r git branch -d; git branch -vv | awk '/\\[gone\\]/ {print $1}' | grep -vE '^(main|master)$' | xargs -r git branch -D";
        gtx = "git fetch --prune --prune-tags --tags";
      };

      # .zshenv is re-sourced by every zsh (even inside a stale tmux server whose
      # inherited hm-session-vars guard skips sessionVariables). Append the
      # managed pkg-config paths (deduped, so dev shells keep priority) and set
      # Colima on every shell startup.
      envExtra = ''
        typeset -gxUT PKG_CONFIG_PATH pkg_config_path
        pkg_config_path+=(${
          lib.concatMapStringsSep " " lib.escapeShellArg (
            lib.splitString ":" config.home.sessionVariables.PKG_CONFIG_PATH
          )
        })
        export COLIMA_SAVE_CONFIG=false
      '';

      profileExtra = ''
        if (( $#commands[(i)lesspipe(|.sh)] )); then
          export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
        fi

        export PATH="$PATH:''${GOPATH//://bin:}/bin"
      '';

      initContent = lib.mkMerge [
        (lib.mkOrder 550 ''
          fpath=(${homeDir}/.local/share/zsh/site-functions ${dotfilesPath}/config/zsh/git/functions $fpath)
        '')
        ''
          # zle helpers prezto used to provide.
          autoload -Uz zargs zmv

          # Completion behavior (case-sensitive, menus, caching).
          zstyle ':completion:*' menu select
          zstyle ':completion:*' use-cache on
          zstyle ':completion:*' cache-path "${config.xdg.cacheHome}/zsh/zcompcache"
          zstyle ':completion:*' group-name '''
          zstyle ':completion:*' squeeze-slashes true
          zstyle ':completion:*:matches' group 'yes'
          zstyle ':completion:*:options' description 'yes'
          zstyle ':completion:*:options' auto-description '%d'
          zstyle ':completion:*:default' list-colors ''${(s.:.)LS_COLORS}
          zstyle ':completion:*:descriptions' format ' -- %d --'
          zstyle ':completion:*:warnings' format ' -- no matches found --'

          # Git aliases and helpers vendored from prezto's git module; see
          # config/zsh/git/README.md. Out-of-store paths, like config/ symlinks,
          # so edits take effect in new shells without a rebuild.
          autoload -Uz ${dotfilesPath}/config/zsh/git/functions/[^_]*(N.:t)
          source ${dotfilesPath}/config/zsh/git/alias.zsh

          # History search from vi normal mode with k/j.
          bindkey -M vicmd 'k' history-substring-search-up
          bindkey -M vicmd 'j' history-substring-search-down

          export KEYTIMEOUT=1

          noop () { }
          zle -N noop
          for keymap in vicmd viins; do
            for key in kcuu1 kcud1 kcub1 kcuf1; do
              bindkey -M "$keymap" "$terminfo[$key]" noop
            done
          done

          # Multi-account Claude Code: each profile is an isolated
          # CLAUDE_CONFIG_DIR, so credentials and session state never cross
          # accounts. Shared config (CLAUDE.md/commands/agents/skills) is
          # symlinked from ~/.claude-shared by home.file. Each profile needs
          # one interactive /login; upstream requires that per profile.
          #
          # `${claudeDefaultProfile}` is deliberately the *absence* of
          # CLAUDE_CONFIG_DIR, not a path to ~/.claude. Claude Code only keeps
          # its account/onboarding state at ~/.claude.json while the variable
          # is unset; exporting it — even to ~/.claude — makes it read
          # $CLAUDE_CONFIG_DIR/.claude.json instead, which has no oauthAccount
          # and re-runs onboarding. The map still records the directory because
          # the settings merge and shared symlinks need it; only ccuse
          # treats the default specially.
          typeset -gA CLAUDE_PROFILES=(${
            lib.concatStringsSep " " (
              lib.mapAttrsToList (profile: dir: "${profile} \"${dir}\"") claudeProfileDirs
            )
          })

          # One launch under a profile; the ccm/cca aliases always pass the
          # profile. Routed through ccuse so the unset-vs-export rule has
          # exactly one owner; the subshell keeps ccuse's environment change
          # local to this launch.
          _claude_launch() {
            (
              ccuse "$1" > /dev/null || exit 1
              shift
              command claude "$@"
            )
          }

          # Pin every later claude in this shell (and tmux pane) to a profile.
          ccuse() {
            local dir="''${CLAUDE_PROFILES[$1]}"
            if [[ -z "$dir" ]]; then
              echo "usage: ccuse <''${(kj:|:)CLAUDE_PROFILES}>" >&2
              return 1
            fi
            if [[ "$1" == ${claudeDefaultProfile} ]]; then
              unset CLAUDE_CONFIG_DIR
            else
              export CLAUDE_CONFIG_DIR="$dir"
            fi
            echo "→ $1"
          }

          # Default a bare `ollmcp` to filesystem and serena MCP tools scoped to
          # the current directory; without server flags ollmcp would otherwise
          # fall back to auto-discovering Claude's config and expose no tools.
          # Skip the injection when the caller already names servers, so
          # `ollmcp --servers-json ...` / `-s` / `-u` still reach the real CLI.
          # Serena is project-scoped via --project rather than
          # SERENA_PROJECT_ROOT because ollmcp hands "env" to the MCP SDK as the
          # entire subprocess environment, which would strip PATH from serena.
          ollmcp() {
            if (( ''${@[(I)(--servers-json|-j|--mcp-server|-s|--mcp-server-url|-u|--auto-discovery|-a)]} )); then
              command ollmcp "$@"
            else
              command ollmcp --servers-json =(jq -n --arg dir "$PWD" '{
                mcpServers: {
                  filesystem: {command: "mcp-server-filesystem", args: [$dir]},
                  serena: {
                    command: "serena",
                    args: ["start-mcp-server", "--project", $dir]
                  }
                }
              }') "$@"
            fi
          }

          function sesh-sessions() {
            {
              exec </dev/tty
              exec <&1
              local session
              session=$(sesh list -t -c | fzf --height 40% --reverse --border-label ' sesh ' --border --prompt 'sesh> ')
              zle reset-prompt >/dev/null 2>&1 || true
              [[ -z "$session" ]] && return
              sesh connect "$session"
            }
          }
          if command -v sesh >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; then
            zle -N sesh-sessions
            bindkey -M vicmd '^f' sesh-sessions
            bindkey -M viins '^f' sesh-sessions
          fi

          # Nix profiles first (existing dirs, symlinks followed), deduplicated.
          typeset -gU path
          path=(
            /etc/profiles/per-user/${username}/bin(N-/)
            ${homeDir}/.nix-profile/bin(N-/)
            /nix/var/nix/profiles/default/bin(N-/)
            $path
          )

          [ -f ~/.kubectl_aliases ] && source ~/.kubectl_aliases
          function kubectl() { echo "+ kubectl $@">&2; command kubectl "$@"; }

          function tmux() {
            if [[ -n "$TMUX" && ( "$1" == "a" || "$1" == "attach" || "$1" == "attach-session" ) ]]; then
              shift
              if (( $# == 0 )); then
                local session
                session=$(command tmux list-sessions -F '#{session_name}' -f '#{==:#{session_attached},0}' 2>/dev/null | head -1)
                [[ -n "$session" ]] && command tmux switch-client -t "$session" || command tmux switch-client
              else
                command tmux switch-client "$@"
              fi
            else
              command tmux "$@"
            fi
          }

          # Anonymous function so `session` doesn't leak into the shell.
          () {
            [[ -z "$TMUX" && -t 0 && -t 1 ]] && (( $+commands[tmux] )) || return 0
            local session
            session=$(tmux list-sessions -F '#{session_name}' -f '#{==:#{session_attached},0}' 2>/dev/null | head -1)
            if [[ -n "$session" ]]; then
              tmux attach -t "$session" || true
            else
              tmux new-session -s "default-$$" || true
            fi
          }
        ''
      ];
    };
  };
}
