{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "Agent Fleet",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:UTC}",
      "GIT_DELTA_VERSION": "0.18.2",
      "CODEX_VERSION": "0.144.1",
      "ZSH_IN_DOCKER_VERSION": "1.2.1"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "runArgs": [
    "--cap-add=SYS_ADMIN",
    "--cap-add=SYS_CHROOT",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--cap-add=SYS_PTRACE",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "init": true,
  "updateRemoteUserUID": true,
  "remoteUser": "vscode",
  "mounts": [
    "source=devc-${localWorkspaceFolderBasename}-fleet-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=devc-${localWorkspaceFolderBasename}-fleet-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=devc-${localWorkspaceFolderBasename}-fleet-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=devc-${localWorkspaceFolderBasename}-fleet-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=${localEnv:DOTFILES_PATH}/config/git/gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh/id_ed25519.pub,target=/home/vscode/.ssh/id_ed25519.pub,type=bind,readonly",
    "source=${localEnv:DOTFILES_PATH}/config/git/allowed_signers,target=/home/vscode/.config/git/allowed_signers,type=bind,readonly",
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind"
  ],
  "containerEnv": {
    "AGENT_ENABLE_FIREWALL": "0",
    "CLAUDE_BYPASS_PERMISSIONS": "1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "CODEX_UNSAFE_ALLOW_NO_SANDBOX": "1",
    "GIT_CONFIG_GLOBAL": "/home/vscode/.gitconfig.local",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "NPM_CONFIG_AUDIT": "true",
    "NPM_CONFIG_FUND": "false",
    "NPM_CONFIG_IGNORE_SCRIPTS": "true",
    "NPM_CONFIG_MINIMUM_RELEASE_AGE": "1440",
    "NPM_CONFIG_SAVE_EXACT": "true",
    "NPM_CONFIG_UPDATE_NOTIFIER": "false",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "PYTHONDONTWRITEBYTECODE": "1",
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock",
    "UV_LINK_MODE": "copy"
  },
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN:}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY:}"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "uv run --no-project /opt/post_install.py && git config --file ~/.gitconfig.local --add safe.directory '*'",
  "postStartCommand": "bash /opt/post_start.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "bash",
            "icon": "terminal-bash"
          },
          "zsh": {
            "path": "zsh"
          }
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true
      }
    }
  }
}
