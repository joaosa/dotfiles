{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": [".opencode/instructions.md"],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false",
        "--project",
        "."
      ],
      "timeout": 30000
    },
    "context7": {
      "type": "local",
      "command": ["context7-mcp"]
    }
  },
  "model": "ollama/muse-glimmer:30b-mlx",
  "small_model": "ollama/qwen3:0.6b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1",
        "timeout": 900000,
        "chunkTimeout": 120000
      },
      "models": {
        "muse-glimmer:30b-mlx": {
          "name": "Muse Glimmer 30B (local MLX)",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "qwen3:0.6b": {
          "name": "Qwen3 0.6B (titles/summaries)",
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
