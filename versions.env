#!/usr/bin/env bash
# Consolidated version pins for legacy bootstrap packages.
# Edit this file to update versions. Run ./bootstrap to apply.
# Nix manages most packages. This file only covers remaining legacy extras.
# shellcheck disable=SC2034  # All variables are used by sourcing scripts

# Go packages not currently packaged in nixpkgs (go install format)
GO_PACKAGES=(
  "github.com/cirocosta/asciinema-edit@v0.0.0-20190130154215-1c0971ae232a"
)

# Cargo packages not currently packaged in nixpkgs (crate:binary format)
CARGO_PACKAGES=(
  "openpgp-card-tool-git:oct-git"   # Git signing without gpg-agent
  "qwen-asr-cli:qwen-asr"          # Speech-to-text (Qwen3 ASR)
)
